# =============================================================================
# Campusly Environment Variables
# =============================================================================
# Set your deployment URL or local URL:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration
# Required for hosted / production deployment (e.g., Vercel + Supabase).
# For local dev without Supabase, leaving these unset runs embedded Postgres.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Demo Mode (pre-fills sample data for testing)
NEXT_PUBLIC_DEMO_MODE=false
