# =============================================================================
# Campusly Environment Variables
# =============================================================================
#
# Campusly operates in two primary modes:
#   1. LOCAL DEVELOPMENT (Embedded PGlite):
#      Leave NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY blank.
#      The app will automatically spin up an embedded WebAssembly Postgres
#      instance with schemas, migrations, and seed data without requiring external servers.
#
#   2. PRODUCTION / HOSTED (Supabase):
#      Configure the Supabase project keys below. Full auth, PostgreSQL database,
#      RLS security policies, and storage buckets are used.
#
# =============================================================================

# Site URL
# The canonical URL where this application is hosted. Used for metadata,
# sitemaps, OpenGraph cards, and auth redirect URLs.
# In local development: http://localhost:3000
# In production: https://campusly.pk (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Configuration (Required for hosted production)
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-only secret)
# Used for backend administrative operations and database setup/seed scripts.
# NEVER expose this key with NEXT_PUBLIC_ prefix!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Local Development Settings
# -----------------------------------------------------------------------------
# Optional custom directory path for local embedded Postgres database storage.
# Defaults to .data/pg if omitted.
LOCAL_PG_DIR=.data/pg

# Feature flag: display seeded demo test accounts on the sign-in screen
# Values: true | false
# Defaults to true in local embedded mode, false when Supabase is configured.
NEXT_PUBLIC_DEMO_MODE=false
